{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "isolatedModules": false,
    "outDir": ".sim-dist",
    "rootDir": "src",
    "types": []
  },
  "include": [
    "src/types/**/*.ts",
    "src/core/**/*.ts",
    "src/data/**/*.ts",
    "src/systems/**/*.ts",
    "src/tests/**/*.ts",
    "src/services/SaveSystem.ts"
  ]
}
